# Copia este archivo a .env.local y rellena tus valores. .env.local NUNCA se sube a git.

# Google Cloud > APIs y servicios > Credenciales > ID de cliente OAuth (tipo "Aplicacion web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Nombre del calendario que el agente puede tocar (crealo antes en Google Calendar)
GOOGLE_CALENDARIO=Agente de voz (demo)
# Lo escribe la app sola al terminar el consentimiento (/api/google/login)
GOOGLE_REFRESH_TOKEN=

# Servicio local de Whisper (python stt/servidor.py)
STT_URL=http://127.0.0.1:8765
