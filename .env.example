# Copia este archivo a .env.local y rellena tus valores. .env.local NUNCA se sube a git.

# Google Cloud > APIs y servicios > Credenciales > ID de cliente OAuth (tipo "Aplicacion web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Nombre del calendario que la app crea al conectarse (solo podra tocar ese)
GOOGLE_CALENDARIO=Agente de voz (demo)
# Los escribe la app sola al terminar el consentimiento (/api/google/login)
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Servicio local de Whisper (python stt/servidor.py)
STT_URL=http://127.0.0.1:8765

# ---- Sesion 4 ----
# Proveedor del LLM de intencion: ollama (local, por defecto) o gemini (produccion, capa gratuita de Google AI Studio)
LLM=ollama
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
# Donde corre Whisper: servidor (stt/ en Python, local) o navegador (Transformers.js, produccion)
NEXT_PUBLIC_STT=servidor
NEXT_PUBLIC_WHISPER_MODELO=onnx-community/whisper-base
# Firma de la cookie de la conversacion (32 caracteres o mas). Obligatoria en Vercel
APP_SECRETO=
# Clave de acceso a la app publicada. Vacia = sin puerta (solo en local)
APP_CLAVE=
